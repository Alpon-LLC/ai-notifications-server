{
  "name": "hermes-notification-server",
  "version": "1.1.0",
  "private": true,
  "description": "Lightweight webhook server for Hermes contact-form notifications.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --env-file=.env --watch --import tsx src/server.ts",
    "start": "node --env-file=.env dist/server.js",
    "test": "node --env-file=.env --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^6.2.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
